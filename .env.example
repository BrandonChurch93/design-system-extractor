# Copy to .env.local at the repository root. Never commit .env.local.

# Model access. Required for live model calls during the build and in production.
ANTHROPIC_API_KEY=
# Optional overrides of the verified model ids in packages/pipeline/src/models/config.ts.
DSE_MODEL_SMALL=
DSE_MODEL_LARGE=

# Build-time spend ceiling for live model calls, USD, and the part reserved for the final live eval.
DSE_DEV_SPEND_CAP_USD=20
DSE_DEV_SPEND_RESERVE_USD=4
# live | record | replay. Tests and `pnpm evals` force replay. Default elsewhere: live.
DSE_MODEL_MODE=live
# Keep intermediate capture files (snapshots, matched CSS) after a run finishes. 0 or 1.
DSE_KEEP_INTERMEDIATE=0

# Local services (docker compose up). Production values come from the deploy runbook.
DATABASE_URL=postgres://dse:dse@localhost:5432/dse
REDIS_URL=redis://localhost:6379
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=dse
STORAGE_ACCESS_KEY=dse
STORAGE_SECRET_KEY=dsedsedse
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/dse

# Caps and budget. Defaults are the v1 decisions; override only in an environment.
DSE_GLOBAL_DAILY_BUDGET_USD=2.00
DSE_VISITOR_RUNS_PER_DAY=2
DSE_PAGE_CAP=12
DSE_BYO_PAGE_CAP=40
DSE_WORST_CASE_RUN_USD=0.60
DSE_RUN_TIMEOUT_MS=360000
# Showcase runs (the owner's, priority 10) get longer, so the home page shows complete runs (D-071).
DSE_SHOWCASE_TIMEOUT_MS=900000
DSE_BUDGET_TIMEZONE=America/Boise
# Hosts the private-address guard lets through, comma separated. Needed locally so the
# fixture server (4100) and `dse serve` (4300) can be crawled. Must be empty in production;
# `pnpm run doctor --production` fails if it is set.
DSE_ALLOW_PRIVATE_HOSTS=localhost:4100,localhost:4300

# Secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DSE_JOB_ENCRYPTION_KEY=
DSE_ADMIN_TOKEN=

# Public URL of the web app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bot identity. Keep honest. The contact path is served by the web app.
DSE_USER_AGENT=DesignSystemExtractorBot/1.0 (+http://localhost:3000/how-it-works)
# Shown on About and Privacy and used by "Report a problem with this run".
DSE_CONTACT_EMAIL=brandonleochurch@gmail.com

# V2 surfaces. Must be false in every v1 environment. The client-side NEXT_PUBLIC_BILLING_ENABLED is derived from this at build time; never set it by hand.
BILLING_ENABLED=false
