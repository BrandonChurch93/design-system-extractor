{
  "name": "design-system-extractor",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs node scripts/dev.mjs",
    "check": "node scripts/run.mjs node scripts/steps.mjs lint typecheck test:unit",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel --reporter-hide-prefix typecheck",
    "test": "node scripts/run.mjs vitest run --passWithNoTests",
    "test:unit": "node scripts/run.mjs vitest run --passWithNoTests --project unit",
    "test:integration": "node scripts/run.mjs vitest run --passWithNoTests --project integration",
    "test:security": "node scripts/run.mjs vitest run --passWithNoTests --project unit --project integration --testNamePattern \"^security\"",
    "test:e2e": "node scripts/run.mjs playwright test --config playwright.config.ts --pass-with-no-tests",
    "fixtures:serve": "node scripts/run.mjs tsx scripts/fixtures-serve.ts",
    "fixtures:build": "node scripts/run.mjs tsx scripts/fixtures-build.ts",
    "pipeline:run": "node scripts/run.mjs tsx scripts/pipeline-run.ts",
    "evals": "node scripts/run.mjs tsx scripts/evals.ts",
    "evals:gate": "node scripts/run.mjs tsx scripts/evals.ts --through components",
    "db:migrate": "node scripts/run.mjs tsx scripts/db-migrate.ts",
    "db:reset": "node scripts/run.mjs tsx scripts/db-reset.ts",
    "db:seed:fixtures": "node scripts/run.mjs tsx scripts/db-seed-fixtures.ts",
    "qa:design": "node scripts/run.mjs playwright test --config playwright.qa.config.ts --project design --pass-with-no-tests",
    "qa:visual": "node scripts/run.mjs playwright test --config playwright.qa.config.ts --project visual --pass-with-no-tests --update-snapshots=missing",
    "qa:axe": "node scripts/run.mjs playwright test --config playwright.qa.config.ts --project axe --pass-with-no-tests",
    "qa:lighthouse": "node scripts/run.mjs tsx scripts/qa-lighthouse.ts",
    "qa:copy": "node scripts/run.mjs tsx scripts/qa-copy.ts",
    "build": "node scripts/run.mjs pnpm -r build",
    "verify:all": "node scripts/run.mjs node scripts/steps.mjs check test test:e2e evals:gate build qa:visual qa:axe qa:lighthouse qa:copy audit",
    "audit": "pnpm audit --audit-level high",
    "showcase": "node scripts/run.mjs tsx scripts/showcase/index.ts",
    "doctor": "node scripts/run.mjs tsx scripts/doctor.ts",
    "prompts:build": "node scripts/run.mjs tsx scripts/prompts-build.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@axe-core/playwright": "4.14.0",
    "@dse/pipeline": "workspace:^",
    "@dse/schema": "workspace:^",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pngjs": "^6.0.5",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "16.4.0",
    "ioredis": "6.0.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postgres": "3.4.9",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
